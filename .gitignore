# Synced project checkouts are independent repositories; the meta-repo
# tracks only the manifest and workspace-level files.
projects/*
!projects/.gitkeep
.env
*.local.*
.venv/
__pycache__/
mcp/doc-search/.index/

# Python distribution artifacts
mcp/doc-search/dist/
mcp/doc-search/build/
mcp/doc-search/*.egg-info/
